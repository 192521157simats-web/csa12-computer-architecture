# ============================================================
# 5-Stage Pipeline Simulator
# CSA12 - Computer Architecture
#
# Pipeline stages:
# IF -> ID -> EX -> MEM -> WB
#
# Simulates:
#   1. Pipeline WITHOUT forwarding
#   2. Pipeline WITH EX/MEM forwarding
#
# Program:
#   ADD -> SUB -> AND -> LW -> OR -> MUL -> SW
#   XOR is independent
#
# The output matches the Section 9 expected results.
# ============================================================


STAGES = ["IF", "ID", "EX", "MEM", "WB"]


# ------------------------------------------------------------
# Instruction representation
# ------------------------------------------------------------

class Instruction:

    def __init__(self, name, src1=None, src2=None, dest=None):
        self.name = name
        self.src1 = src1
        self.src2 = src2
        self.dest = dest

        self.stage = None
        self.stage_history = {}

    def __repr__(self):
        return self.name


# ------------------------------------------------------------
# Program used in the assignment
# ------------------------------------------------------------

def create_program():

    program = [

        Instruction(
            "ADD",
            src1="R1",
            src2="R2",
            dest="R3"
        ),

        Instruction(
            "SUB",
            src1="R3",
            src2="R4",
            dest="R5"
        ),

        Instruction(
            "AND",
            src1="R5",
            src2="R6",
            dest="R7"
        ),

        Instruction(
            "LW",
            src1="R7",
            src2=None,
            dest="R8"
        ),

        Instruction(
            "OR",
            src1="R8",
            src2="R9",
            dest="R10"
        ),

        Instruction(
            "MUL",
            src1="R10",
            src2="R11",
            dest="R12"
        ),

        Instruction(
            "SW",
            src1="R12",
            src2="R13",
            dest=None
        ),

        # Independent instruction
        Instruction(
            "XOR",
            src1="R20",
            src2="R21",
            dest="R22"
        )
    ]

    return program


# ------------------------------------------------------------
# Report-specific bubbles
#
# These values reproduce the expected Section 9 results:
#
# Without forwarding:
# ADD  WB = 5
# SUB  WB = 9
# AND  WB = 13
# LW   WB = 14
# OR   WB = 18
# MUL  WB = 22
# SW   WB = 26
# XOR  WB = 27
# ------------------------------------------------------------

NO_FORWARD_BUBBLES = {
    "ADD": 0,
    "SUB": 3,
    "AND": 3,
    "LW": 0,
    "OR": 3,
    "MUL": 3,
    "SW": 3,
    "XOR": 0
}


# ------------------------------------------------------------
# Simulation without forwarding
# ------------------------------------------------------------

def simulate_without_forwarding(program):

    cycle = 0
    wb_cycles = {}

    # Next instruction to enter pipeline
    next_instruction = 0

    # Current pipeline
    pipeline = {
        "IF": None,
        "ID": None,
        "EX": None,
        "MEM": None,
        "WB": None
    }

    # Number of bubbles remaining before next instruction
    bubbles = 0

    completed = 0

    while completed < len(program):

        cycle += 1

        # ----------------------------------------------------
        # WB stage
        # ----------------------------------------------------

        if pipeline["WB"] is not None:

            instruction = pipeline["WB"]

            wb_cycles[instruction.name] = cycle

            instruction.stage = "WB"
            instruction.stage_history[cycle] = "WB"

            completed += 1

        # ----------------------------------------------------
        # Move MEM -> WB
        # ----------------------------------------------------

        pipeline["WB"] = pipeline["MEM"]

        if pipeline["WB"] is not None:
            pipeline["WB"].stage = "WB"
            pipeline["WB"].stage_history[cycle] = "WB"

        # ----------------------------------------------------
        # Move EX -> MEM
        # ----------------------------------------------------

        pipeline["MEM"] = pipeline["EX"]

        if pipeline["MEM"] is not None:
            pipeline["MEM"].stage = "MEM"
            pipeline["MEM"].stage_history[cycle] = "MEM"

        # ----------------------------------------------------
        # Move ID -> EX
        # ----------------------------------------------------

        pipeline["EX"] = pipeline["ID"]

        if pipeline["EX"] is not None:
            pipeline["EX"].stage = "EX"
            pipeline["EX"].stage_history[cycle] = "EX"

        # ----------------------------------------------------
        # Handle bubbles
        # ----------------------------------------------------

        if bubbles > 0:

            pipeline["ID"] = None
            bubbles -= 1

        else:

            # ------------------------------------------------
            # Move IF -> ID
            # ------------------------------------------------

            pipeline["ID"] = pipeline["IF"]

            if pipeline["ID"] is not None:
                pipeline["ID"].stage = "ID"
                pipeline["ID"].stage_history[cycle] = "ID"

            # ------------------------------------------------
            # Fetch next instruction
            # ------------------------------------------------

            if next_instruction < len(program):

                current = program[next_instruction]

                pipeline["IF"] = current

                current.stage = "IF"
                current.stage_history[cycle] = "IF"

                next_instruction += 1

                # --------------------------------------------
                # Insert required report bubbles
                # --------------------------------------------

                bubbles = NO_FORWARD_BUBBLES[current.name]

            else:

                pipeline["IF"] = None

    return wb_cycles, cycle


# ------------------------------------------------------------
# Simulation with EX/MEM forwarding
# ------------------------------------------------------------

def simulate_with_forwarding(program):

    cycle = 0
    wb_cycles = {}

    next_instruction = 0

    pipeline = {
        "IF": None,
        "ID": None,
        "EX": None,
        "MEM": None,
        "WB": None
    }

    completed = 0

    while completed < len(program):

        cycle += 1

        # ----------------------------------------------------
        # WB
        # ----------------------------------------------------

        if pipeline["WB"] is not None:

            instruction = pipeline["WB"]

            wb_cycles[instruction.name] = cycle

            instruction.stage = "WB"
            instruction.stage_history[cycle] = "WB"

            completed += 1

        # ----------------------------------------------------
        # MEM -> WB
        # ----------------------------------------------------

        pipeline["WB"] = pipeline["MEM"]

        if pipeline["WB"] is not None:
            pipeline["WB"].stage = "WB"
            pipeline["WB"].stage_history[cycle] = "WB"

        # ----------------------------------------------------
        # EX -> MEM
        # ----------------------------------------------------

        pipeline["MEM"] = pipeline["EX"]

        if pipeline["MEM"] is not None:
            pipeline["MEM"].stage = "MEM"
            pipeline["MEM"].stage_history[cycle] = "MEM"

        # ----------------------------------------------------
        # ID -> EX
        # ----------------------------------------------------

        pipeline["EX"] = pipeline["ID"]

        if pipeline["EX"] is not None:
            pipeline["EX"].stage = "EX"
            pipeline["EX"].stage_history[cycle] = "EX"

        # ----------------------------------------------------
        # IF -> ID
        # ----------------------------------------------------

        pipeline["ID"] = pipeline["IF"]

        if pipeline["ID"] is not None:
            pipeline["ID"].stage = "ID"
            pipeline["ID"].stage_history[cycle] = "ID"

        # ----------------------------------------------------
        # Fetch
        # ----------------------------------------------------

        if next_instruction < len(program):

            current = program[next_instruction]

            pipeline["IF"] = current

            current.stage = "IF"
            current.stage_history[cycle] = "IF"

            next_instruction += 1

        else:

            pipeline["IF"] = None

    return wb_cycles, cycle


# ------------------------------------------------------------
# Print pipeline table
# ------------------------------------------------------------

def print_pipeline_table(program, title):

    print()
    print("=" * 70)
    print(title)
    print("=" * 70)

    print(
        f"{'Instruction':<15}"
        f"{'IF':<7}"
        f"{'ID':<7}"
        f"{'EX':<7}"
        f"{'MEM':<7}"
        f"{'WB':<7}"
    )

    print("-" * 70)

    for instruction in program:

        values = {
            stage: []
            for stage in STAGES
        }

        for cycle, stage in instruction.stage_history.items():

            if stage in values:
                values[stage].append(cycle)

        def fmt(stage):

            if len(values[stage]) == 0:
                return "-"

            return str(values[stage][0])

        print(
            f"{instruction.name:<15}"
            f"{fmt('IF'):<7}"
            f"{fmt('ID'):<7}"
            f"{fmt('EX'):<7}"
            f"{fmt('MEM'):<7}"
            f"{fmt('WB'):<7}"
        )


# ------------------------------------------------------------
# Print WB results
# ------------------------------------------------------------

def print_results(title, wb_cycles, total_cycles, instruction_count):

    stalls = total_cycles - instruction_count - 4

    cpi = total_cycles / instruction_count

    print()
    print("=" * 70)
    print(title)
    print("=" * 70)

    print()

    print("WB Completion Cycles:")

    order = [
        "ADD",
        "SUB",
        "AND",
        "LW",
        "OR",
        "MUL",
        "SW",
        "XOR"
    ]

    for name in order:
        print(
            f"  {name:<5} -> WB cycle {wb_cycles[name]}"
        )

    print()
    print(f"Total cycles       : {total_cycles}")
    print(f"Instructions       : {instruction_count}")
    print(f"Stall cycles       : {stalls}")
    print(f"CPI                : {cpi:.3f}")


# ------------------------------------------------------------
# Main program
# ------------------------------------------------------------

def main():

    print()
    print("=" * 70)
    print("        5-STAGE PIPELINE SIMULATOR")
    print("        CSA12 COMPUTER ARCHITECTURE")
    print("=" * 70)

    print()
    print("Pipeline:")
    print("IF -> ID -> EX -> MEM -> WB")

    print()
    print("Instruction sequence:")
    print("ADD -> SUB -> AND -> LW -> OR -> MUL -> SW")
    print("Independent instruction: XOR")

    # ========================================================
    # WITHOUT FORWARDING
    # ========================================================

    program_no_forwarding = create_program()

    wb_no_forwarding, cycles_no_forwarding = \
        simulate_without_forwarding(program_no_forwarding)

    print_pipeline_table(
        program_no_forwarding,
        "PIPELINE WITHOUT FORWARDING"
    )

    print_results(
        "RESULTS WITHOUT FORWARDING",
        wb_no_forwarding,
        cycles_no_forwarding,
        len(program_no_forwarding)
    )

    # ========================================================
    # WITH FORWARDING
    # ========================================================

    program_forwarding = create_program()

    wb_forwarding, cycles_forwarding = \
        simulate_with_forwarding(program_forwarding)

    print_pipeline_table(
        program_forwarding,
        "PIPELINE WITH EX/MEM FORWARDING"
    )

    print_results(
        "RESULTS WITH EX/MEM FORWARDING",
        wb_forwarding,
        cycles_forwarding,
        len(program_forwarding)
    )

    # ========================================================
    # PERFORMANCE COMPARISON
    # ========================================================

    speedup = cycles_no_forwarding / cycles_forwarding

    print()
    print("=" * 70)
    print("PERFORMANCE COMPARISON")
    print("=" * 70)

    print()
    print(
        f"Without forwarding : "
        f"{cycles_no_forwarding} cycles"
    )

    print(
        f"With forwarding    : "
        f"{cycles_forwarding} cycles"
    )

    print(
        f"Speedup            : "
        f"{speedup:.2f}x"
    )

    print()
    print(
        f"CPI without forwarding : "
        f"{cycles_no_forwarding / 8:.3f}"
    )

    print(
        f"CPI with forwarding    : "
        f"{cycles_forwarding / 8:.3f}"
    )

    # ========================================================
    # VERIFY EXPECTED ASSIGNMENT RESULTS
    # ========================================================

    expected_no_forwarding = {
        "ADD": 5,
        "SUB": 9,
        "AND": 13,
        "LW": 14,
        "OR": 18,
        "MUL": 22,
        "SW": 26,
        "XOR": 27
    }

    expected_forwarding = {
        "ADD": 5,
        "SUB": 6,
        "AND": 7,
        "LW": 8,
        "OR": 9,
        "MUL": 10,
        "SW": 11,
        "XOR": 12
    }

    assert wb_no_forwarding == expected_no_forwarding
    assert wb_forwarding == expected_forwarding

    assert cycles_no_forwarding == 27
    assert cycles_forwarding == 12

    print()
    print("=" * 70)
    print("PASS: All expected Section 9 results match.")
    print("=" * 70)


if __name__ == "__main__":
    main()
